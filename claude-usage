#!/usr/bin/env python3
"""Live-Ansicht des Claude-Code-Verbrauchs im Terminal.

Limits kommen von `omarchy-agent-usage-claude` (Anthropics OAuth-Endpoint),
die Token-Zahlen aus einem eigenen Scan der Transcripts unter
~/.claude/projects — der Collector liefert keine Aufschlüsselung pro Session.

Aufruf:  claude-usage            einmalig
         claude-usage -w [SEK]   live, Default 60 s
         claude-usage --export   Zahlen als JSON (fuer andere Rechner)
"""

from __future__ import annotations

import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from types import SimpleNamespace

COLLECTOR = "omarchy-agent-usage-claude"   # liefert Tarif und Limits
EXPORT_SCHEMA = 1
CONFIG_PATH = "~/.config/claude-usage/config.json"
CACHE_DIR = "~/.cache/claude-usage"
REMOTE_TIMEOUT = 20        # Sekunden je Remote
REMOTE_STALE_HOURS = 12    # danach gilt ein zwischengespeicherter Stand als alt
WINDOW_HOURS = 24
GRAPH_ROWS = 8
SESSION_ROWS = 12          # danach fasst eine Zeile den Rest zusammen

# Satzarten, die einen Sessiontitel tragen. Welche davon geschrieben werden und
# wie ihr Textfeld heißt, unterscheidet sich je nach Claude-Code-Version —
# deshalb wird der Wert generisch gelesen statt über feste Feldnamen.
TITLE_TYPES = {"custom-title": 2, "ai-title": 1, "agent-name": 0}
TITLE_SKIP = {"type", "sessionId", "uuid", "leafUuid", "parentUuid",
              "logicalParentUuid", "timestamp", "cwd", "version", "gitBranch"}

# Grundbreite; alles darüber hinaus geht an die Balken bzw. Session-Namen.
BASE_INNER = 84
MIN_WIDTH = 86
MAX_WIDTH = 200
GRAPH_LABELS = (5, 6, 5)   # "12-15", "10.09.", "KW 37"
VALUE_CHARS = 8            # rechte Zahlenspalte der Graphen
PROJECT_MIN = 12           # ab dieser Breite lohnt die Projektspalte
PROJECT_MAX = 28
DEVICE_CHARS = 12          # Spaltenbreite für den Gerätenamen

USAGE_KEYS = (
    ("input_tokens", "inputTokens"),
    ("output_tokens", "outputTokens"),
    ("cache_read_input_tokens", "cacheReadInputTokens"),
    ("cache_creation_input_tokens", "cacheCreationInputTokens"),
)


# ------------------------------------------------------------------ Farbe

ANSI = re.compile(r"\033\[[0-9;]*m")
RESET = "\033[0m"
DIM = "\033[2m"

# Stützstellen des btop-Verlaufs: grün → gelb → rot.
GRADIENT = ((0.0, (80, 200, 120)), (0.5, (235, 190, 70)), (1.0, (225, 70, 70)))

# Wochenende im Tagesraster; Mo–Fr bleibt in der Terminalfarbe.
WEEKEND = {5: (205, 145, 75), 6: (200, 100, 95)}   # Sa dezent orange, So dezent rot


def use_color() -> bool:
    return (
        sys.stdout.isatty()
        and os.environ.get("NO_COLOR") is None
        and os.environ.get("TERM") != "dumb"
    )


def gradient(pos: float) -> tuple[int, int, int]:
    """Farbe an relativer Position 0..1, linear zwischen den Stützstellen."""
    pos = min(max(pos, 0.0), 1.0)
    for (low, start), (high, end) in zip(GRADIENT, GRADIENT[1:]):
        if pos <= high:
            share = (pos - low) / (high - low) if high > low else 0.0
            return tuple(round(a + (b - a) * share) for a, b in zip(start, end))
    return GRADIENT[-1][1]


def paint(filled: str, width: int, track: str) -> str:
    """Balken einfärben: jedes Zeichen nach seiner Position, Rest gedimmt.

    Die Farbe hängt an der Position im Balken, nicht am Wert — ein kurzer
    Balken bleibt dadurch grün, ein langer läuft über orange nach rot aus.
    """
    rest = track * (width - len(filled))
    if not use_color():
        return filled + rest
    span = max(width - 1, 1)
    body = "".join(
        "\033[38;2;{};{};{}m{}".format(*gradient(i / span), char)
        for i, char in enumerate(filled)
    )
    return (body + RESET if body else "") + (DIM + rest + RESET if rest else "")


def tint(text: str, color) -> str:
    """Text einfärben. Muss nach dem Ausrichten passieren — die Escape-Codes
    zählen sonst in die Feldbreite."""
    if color is None or not use_color():
        return text
    return "\033[38;2;{};{};{}m{}{}".format(*color, text, RESET)


def visible_len(text: str) -> int:
    return len(ANSI.sub("", text))


# ------------------------------------------------------------------ Layout

def build_layout(with_device: bool = False) -> SimpleNamespace:
    """Spaltenbreiten für die aktuelle Terminalbreite.

    Die drei Blöcke müssen dieselbe Innenbreite ergeben, sonst passen die
    Trennlinien nicht aufeinander:
        sum(limits) + 3 == sum(tokens) + len(tokens) - 1 == sum(graph) + 2 == inner
    Zusatzspalten kosten je ein Zeichen für ihren eigenen Trenner.
    """
    columns = shutil.get_terminal_size((MIN_WIDTH, 24)).columns
    inner = max(MIN_WIDTH, min(columns, MAX_WIDTH)) - 2
    extra = inner - BASE_INNER

    cols = [30, 11, 11, 11, 17]          # Name, heute, 24 h, gesamt, seit
    slack = extra
    if with_device:
        cols.insert(1, DEVICE_CHARS)
        slack -= DEVICE_CHARS + 1
    if slack >= PROJECT_MIN + 1:
        project = min(PROJECT_MAX, max(PROJECT_MIN, (slack - 1) // 3))
        cols.append(project)
        slack -= project + 1
    cols[0] += slack                     # der Rest geht an die Namensspalte

    share = [extra // 3 + (1 if i < extra % 3 else 0) for i in range(3)]
    return SimpleNamespace(
        inner=inner,
        with_device=with_device,
        with_project=len(cols) > (6 if with_device else 5),
        limits=(22, 7, 32 + extra, 20),          # Fenster, Prozent, Balken, Reset
        tokens=tuple(cols),
        graph=(27 + share[0], 28 + share[1], 27 + share[2]),
    )


# ------------------------------------------------------------------ Formatierung

def tokens(n: int) -> str:
    """1234 -> '1.2k', 1231000 -> '1.231M'. Bei M werden Nullen getrimmt."""
    if n >= 999_950_000:   # sonst stuende hier "1981.494M"
        return f"{n / 1_000_000_000:.3f}".rstrip("0").rstrip(".") + "G"
    if n >= 999_950:  # ab hier rundete die k-Darstellung auf 1000.0k auf
        return f"{n / 1_000_000:.3f}".rstrip("0").rstrip(".") + "M"
    if n >= 1000:
        return f"{n / 1000:.1f}k"
    return str(n)


def bar(pct: float, width: int) -> str:
    return paint("█" * int(pct * width), width, "·")


# ------------------------------------------------------------------ Tabelle

def cell(text: str, width: int, right: bool = False) -> str:
    """Zelleninhalt mit je einem Leerzeichen Rand, exakt `width` sichtbare Zeichen."""
    room = width - 2
    pad = room - visible_len(text)
    if pad < 0:
        # Zu lang wird nur ungefärbter Text; gefärbte Zellen (Balken, bereits
        # ausgerichtete Beschriftungen) haben ihre Breite schon fest. Das "…"
        # macht sichtbar, dass hier etwas fehlt.
        return " " + (text[:room] if ANSI.search(text) else text[:room - 1] + "…") + " "
    return " " + (" " * pad + text if right else text + " " * pad) + " "


def row(cells: list[str]) -> str:
    return "│" + "│".join(cells) + "│"


def full_row(text: str, inner: int) -> str:
    return row([cell(text, inner)])


def boundaries(widths) -> set[int]:
    """Zeichen-Offsets, an denen in einer Zeile ein │ steht."""
    marks, pos = set(), 0
    for width in widths[:-1]:
        pos += width
        marks.add(pos)
        pos += 1
    return marks


def separator(above, below, inner: int) -> str:
    """Trennlinie zwischen zwei Blöcken; setzt ┬ ┴ ┼ an die Spaltengrenzen."""
    top, bottom = boundaries(above or ()), boundaries(below or ())
    left = "├" if above and below else ("┌" if below else "└")
    right = "┤" if above and below else ("┐" if below else "┘")
    middle = "".join(
        "┼" if i in top and i in bottom else
        "┴" if i in top else
        "┬" if i in bottom else "─"
        for i in range(inner)
    )
    return left + middle + right


def dots(value: int, peak: int, width: int) -> str:
    """btop-artiger Balken aus Braille-Punkten.

    Ein Braille-Zeichen ist zwei Punktspalten breit, der Balken hat also die
    doppelte Auflösung seiner Zeichenbreite. Ein Wert > 0 bekommt immer
    mindestens einen halben Punkt, damit er nicht als leer durchgeht.
    """
    if peak <= 0:
        return paint("", width, "·")
    steps = round(value / peak * width * 2)
    if value > 0 and steps == 0:
        steps = 1
    full, half = divmod(steps, 2)
    return paint("⣿" * full + ("⡇" if half else ""), width, "·")


def parse_ts(value):
    if not isinstance(value, str) or not value:
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return None


def when(moment: dt.datetime) -> str:
    today = dt.datetime.now().astimezone().date()
    day = moment.date()
    if day == today:
        return f"heute {moment:%H:%M}"
    if day == today - dt.timedelta(days=1):
        return f"gestern {moment:%H:%M}"
    return f"{moment:%d.%m. %H:%M}"


def title_of(entry: dict) -> str:
    """Den Titel aus einem titelartigen Satz ziehen.

    Bekannte Feldnamen zuerst, sonst der erste Textwert, der ersichtlich kein
    Bezeichner ist. So überlebt die Erkennung eine umbenannte Spalte in einer
    anderen Version, ohne dass hier jede Variante gepflegt werden muss.
    """
    for key in ("customTitle", "aiTitle", "agentName", "title", "name"):
        value = entry.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    for key, value in entry.items():
        if key in TITLE_SKIP or not isinstance(value, str):
            continue
        if value.strip() and not value.startswith(("/", "~")):
            return value.strip()
    return ""


def clip(text: str, width: int) -> str:
    return text if len(text) <= width else text[:width] + "..."


def label_for(cwd: str) -> str:
    home = str(Path.home())
    if cwd == home:
        return "~"
    if cwd.startswith(home + "/"):
        return "~/" + cwd[len(home) + 1:]
    return cwd or "?"


# ------------------------------------------------------------------ Transcripts

def scan(projects: Path) -> dict:
    """Token pro Session, dedupliziert über die Message-ID.

    Eine Message-ID taucht mehrfach auf, solange die Antwort streamt; die
    Zeilen tragen wachsende output_tokens. Gezählt wird deshalb das letzte
    Vorkommen (finale usage), nicht das erste.
    """
    now = dt.datetime.now().astimezone()
    today = now.date()
    cutoff = now - dt.timedelta(hours=WINDOW_HOURS)

    messages: dict[str, tuple] = {}   # message id -> (session, ts, total)
    starts: dict[str, dt.datetime] = {}
    cwds: dict[str, str] = {}
    titles: dict[str, tuple] = {}   # session -> (Rang, Titel)

    if not projects.is_dir():
        empty = [("", "", 0, None)] * GRAPH_ROWS
        return {"total_today": 0, "total_window": 0, "sessions": [],
                "prompts_today": 0, "graph": (empty, empty, empty)}

    for path in sorted(projects.rglob("*.jsonl")):
        try:
            handle = path.open("r", encoding="utf-8", errors="replace")
        except OSError:
            continue
        with handle:
            for number, line in enumerate(handle, 1):
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue

                session = entry.get("sessionId")
                stamp = parse_ts(entry.get("timestamp"))

                # Claude Code schreibt den Session-Titel als eigene Zeile und
                # aktualisiert ihn im Verlauf; das letzte Vorkommen gilt.
                rank = TITLE_TYPES.get(entry.get("type"))
                if session and rank is not None:
                    title = title_of(entry)
                    # Ein selbst gesetzter Titel schlägt den generierten; bei
                    # gleichem Rang gewinnt der jüngste Eintrag.
                    if title and rank >= titles.get(session, (-1, ""))[0]:
                        titles[session] = (rank, title)

                if session:
                    if stamp and (session not in starts or stamp < starts[session]):
                        starts[session] = stamp
                    # Sidechains (Subagenten) laufen im cwd des Parents; der
                    # erste Treffer gewinnt und ist der der Hauptsession.
                    if entry.get("cwd") and session not in cwds:
                        cwds[session] = entry["cwd"]

                if '"usage":' not in line:
                    continue
                message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
                if entry.get("type") != "assistant" and message.get("role") != "assistant":
                    continue
                usage = message.get("usage") or entry.get("usage")
                if not isinstance(usage, dict):
                    continue

                total = 0
                for snake, camel in USAGE_KEYS:
                    try:
                        total += int(usage.get(snake) or usage.get(camel) or 0)
                    except (TypeError, ValueError):
                        pass
                if total <= 0:
                    continue

                key = str(message.get("id") or entry.get("messageId") or f"{path}:{number}")
                messages[key] = (str(session or path), stamp, total)

    # Zeitraster der Graphen. Taktgebunden statt relativ zu "jetzt", damit die
    # Beschriftung stimmt — der jüngste Block ist dadurch noch unvollständig.
    block = now.replace(hour=(now.hour // 3) * 3, minute=0, second=0, microsecond=0)
    hours = [block - dt.timedelta(hours=3 * i) for i in reversed(range(GRAPH_ROWS))]
    days = [today - dt.timedelta(days=i) for i in reversed(range(GRAPH_ROWS))]
    monday = today - dt.timedelta(days=today.weekday())
    weeks = [monday - dt.timedelta(weeks=i) for i in reversed(range(GRAPH_ROWS))]
    by_hour = dict.fromkeys(hours, 0)
    by_day = dict.fromkeys(days, 0)
    by_week = dict.fromkeys(weeks, 0)

    per_session: dict[str, dict] = {}
    total_today = total_window = prompts_today = 0
    for session, stamp, total in messages.values():
        row = per_session.setdefault(session, {"today": 0, "window": 0, "lifetime": 0, "last": None})
        row["lifetime"] += total
        if stamp:
            if row["last"] is None or stamp > row["last"]:
                row["last"] = stamp
            if stamp.date() == today:
                row["today"] += total
                total_today += total
                prompts_today += 1
            if stamp >= cutoff:
                row["window"] += total
                total_window += total

            slot = stamp.replace(hour=(stamp.hour // 3) * 3, minute=0, second=0, microsecond=0)
            if slot in by_hour:
                by_hour[slot] += total
            day = stamp.date()
            if day in by_day:
                by_day[day] += total
            week = day - dt.timedelta(days=day.weekday())
            if week in by_week:
                by_week[week] += total

    sessions = []
    for session, row in per_session.items():
        if not row["window"]:
            continue
        sessions.append({
            "id": session,
            "name": (titles.get(session) or (0, ""))[1] or session[:8],
            "cwd": label_for(cwds.get(session, "")),
            "start": starts.get(session),
            **row,
        })
    sessions.sort(key=lambda s: s["window"], reverse=True)

    return {
        "total_today": total_today,
        "total_window": total_window,
        "prompts_today": prompts_today,
        "sessions": sessions,
        # Jeder Eintrag: (Schluessel, Beschriftung, Wert, Farbe). Der Schluessel
        # ist absolut, damit sich das Raster eines anderen Rechners zuordnen
        # laesst; die Beschriftung ist reine Darstellung.
        "graph": (
            [(h.isoformat(), f"{h:%H}-{h + dt.timedelta(hours=3):%H}", by_hour[h], None) for h in hours],
            [(d.isoformat(), f"{d:%d.%m.}", by_day[d], WEEKEND.get(d.weekday())) for d in days],
            [(w.isoformat(), f"KW {w.isocalendar()[1]:02d}", by_week[w], None) for w in weeks],
        ),
    }


# ------------------------------------------------------------------ Collector

def config() -> dict:
    path = Path(CONFIG_PATH).expanduser()
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except ValueError as exc:
        print(f"{path}: {exc}", file=sys.stderr)
        return {}


def device_name() -> str:
    """Kurzer Name dieses Rechners für die Geräte-Spalte."""
    return (os.environ.get("CLAUDE_USAGE_DEVICE")
            or config().get("device")
            or os.uname().nodename.split(".")[0])


def export_payload(stats: dict) -> dict:
    """Was ein anderer Rechner von hier braucht — ausschließlich Zahlen.

    Keine Prompts, keine Antworten, keine Dateinamen aus den Transcripts: nur
    Session-Titel, Arbeitsverzeichnis und Zählerstände.
    """
    now = dt.datetime.now().astimezone()
    return {
        "schema": EXPORT_SCHEMA,
        "device": device_name(),
        "generatedAt": now.isoformat(),
        "tzOffsetMinutes": int(now.utcoffset().total_seconds() // 60),
        "windowHours": WINDOW_HOURS,
        "totals": {
            "today": stats["total_today"],
            "window": stats["total_window"],
            "promptsToday": stats["prompts_today"],
        },
        "sessions": [
            {
                "id": session["id"],
                "name": session["name"],
                "cwd": session["cwd"],
                "start": session["start"].isoformat() if session["start"] else None,
                "today": session["today"],
                "window": session["window"],
                "lifetime": session["lifetime"],
            }
            for session in stats["sessions"]
        ],
        "graph": {
            name: [[key, value] for key, _, value, _ in column]
            for name, column in zip(("hours", "days", "weeks"), stats["graph"])
        },
    }


def ssh_error(text: str) -> str:
    """Die aussagekräftige Hälfte einer ssh-Fehlermeldung."""
    line = (text or "").strip().splitlines()
    line = line[-1] if line else "ssh fehlgeschlagen"
    return re.sub(r"^ssh: connect to host \S+ port \d+: ", "", line)[:60]


def probe_targets(targets: list, command: str, connect: int = 5) -> tuple:
    """Alle Adressen gleichzeitig anfragen, die erste Antwort gewinnt.

    Nacheinander zu probieren summiert die Timeouts — bei einem schlafenden
    Rechner mit zwei Adressen wären das zweimal fünf Sekunden Wartezeit im
    Vordergrund. Verlierer werden abgeräumt, sobald einer geantwortet hat.
    """
    running = []
    for target in targets:
        try:
            running.append((target, subprocess.Popen(
                ["ssh", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={connect}",
                 str(target), command],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )))
        except OSError as exc:
            return None, None, f"ssh nicht startbar: {exc.__class__.__name__}"

    deadline = time.monotonic() + REMOTE_TIMEOUT
    failures = {}
    winner = None
    while running and winner is None and time.monotonic() < deadline:
        for entry in list(running):
            target, proc = entry
            if proc.poll() is None:
                continue
            running.remove(entry)
            out, err = proc.communicate()
            if proc.returncode == 0:
                winner = (target, out)
                break
            # 255 ist ssh selbst, alles andere der Exit-Code der Gegenseite.
            failures[target] = ("nicht erreichbar: " if proc.returncode == 255
                                else "Aufruf fehlgeschlagen: ") + ssh_error(err)
        if winner is None and running:
            time.sleep(0.05)

    for _, proc in running:
        proc.kill()
    if winner is not None:
        return winner[0], winner[1], None

    # Der Grund des bevorzugten Ziels ist der aussagekräftige. Ein spät
    # eintreffender Timeout eines Ausweichziels würde ihn sonst überschreiben.
    for target in targets:
        if target in failures:
            return None, None, failures[target]
    return None, None, "nicht erreichbar: keine Antwort"


def fetch_remote(remote: dict) -> dict:
    """Einen Rechner abfragen, mit Rückfall auf den letzten Stand.

    `ssh` darf eine Liste sein — etwa LAN- und VPN-Adresse desselben Rechners.
    Ist keiner erreichbar, gilt der zwischengespeicherte Export weiter, mit
    Altersangabe, damit alte Zahlen nicht als aktuell durchgehen.
    """
    label = str(remote.get("label") or "remote")
    cache = Path(CACHE_DIR).expanduser() / f"{re.sub(r'[^A-Za-z0-9_.-]', '_', label)}.json"
    command = remote.get("command") or "claude-usage --export"

    targets = remote.get("ssh")
    targets = [targets] if isinstance(targets, str) else [t for t in (targets or []) if t]
    if not targets:
        return {"label": label, "error": "kein ssh-Ziel konfiguriert"}

    connect = int(remote.get("connectTimeout") or 5)
    target, output, reason = probe_targets(targets, command, connect)
    if reason is None:
        try:
            payload = json.loads(output)
        except ValueError:
            reason = "Antwort ist kein JSON — läuft dort claude-usage --export?"

        else:
            # Der Cache enthält Sessiontitel und Arbeitsverzeichnisse der
            # anderen Maschine — nichts für andere Konten auf diesem Rechner.
            cache.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            cache.write_text(json.dumps(payload))
            cache.chmod(0o600)
            return {"label": label, "payload": payload, "via": target}

    try:
        payload = json.loads(cache.read_text())
    except Exception:
        return {"label": label, "error": reason}
    return {"label": label, "payload": payload, "stale": reason}


def gather_remotes() -> list:
    remotes = config().get("remotes") or []
    if not remotes:
        return []
    with ThreadPoolExecutor(max_workers=max(1, len(remotes))) as pool:
        return list(pool.map(fetch_remote, remotes))


def merge_remote(stats: dict, payload: dict) -> None:
    """Einen fremden Export in die lokalen Zahlen einrechnen."""
    totals = payload.get("totals") or {}
    stats["total_today"] += int(totals.get("today") or 0)
    stats["total_window"] += int(totals.get("window") or 0)
    stats["prompts_today"] += int(totals.get("promptsToday") or 0)

    device = str(payload.get("device") or "?")
    for session in payload.get("sessions") or []:
        stats["sessions"].append({
            "id": str(session.get("id") or ""),
            "name": str(session.get("name") or ""),
            "cwd": str(session.get("cwd") or ""),
            "device": device,
            "start": parse_ts(session.get("start")),
            "today": int(session.get("today") or 0),
            "window": int(session.get("window") or 0),
            "lifetime": int(session.get("lifetime") or 0),
        })

    graph = payload.get("graph") or {}
    merged = []
    for name, column in zip(("hours", "days", "weeks"), stats["graph"]):
        remote = {str(key): int(value or 0) for key, value in (graph.get(name) or [])}
        merged.append([(key, label, value + remote.get(key, 0), color)
                       for key, label, value, color in column])
    stats["graph"] = tuple(merged)


def limits() -> dict:
    """Limits vom Omarchy-Collector.

    Fehlt er, bleibt nur dieser Block leer — die Token-Zahlen stammen aus dem
    eigenen Transcript-Scan und funktionieren auch ohne Omarchy.
    """
    if shutil.which(COLLECTOR) is None:
        return {"note": f"{COLLECTOR} nicht gefunden — die Limits brauchen Omarchy."}
    try:
        raw = subprocess.run(
            [COLLECTOR, "--limits-only"], capture_output=True, text=True, timeout=60,
        )
        return json.loads(raw.stdout)
    except Exception as exc:
        return {"note": f"Limits nicht abrufbar: {exc.__class__.__name__}."}


# ------------------------------------------------------------------ Ausgabe

def remote_note(result: dict) -> str:
    """Meldung zu einem Remote, oder leer wenn alles in Ordnung ist."""
    label = result["label"]
    if result.get("error"):
        return f"{label}: {result['error']} — keine Zahlen von dort"

    payload = result.get("payload") or {}
    parts = []
    if result.get("stale"):
        stamp = parse_ts(payload.get("generatedAt"))
        age = ""
        if stamp:
            minutes = int((dt.datetime.now().astimezone() - stamp).total_seconds() // 60)
            age = f" — Stand {stamp:%d.%m. %H:%M}, vor {minutes // 60} h {minutes % 60} min"
        parts.append(f"{result['stale']}{age}")

    offset = payload.get("tzOffsetMinutes")
    here = int(dt.datetime.now().astimezone().utcoffset().total_seconds() // 60)
    if offset is not None and int(offset) != here:
        # Tages- und Blockgrenzen entstehen aus der lokalen Uhr des jeweiligen
        # Rechners; bei anderer Zeitzone passen die Raster nicht zusammen.
        parts.append(f"andere Zeitzone (UTC{int(offset) // 60:+d}), Raster passt nicht")

    return f"{label}: " + "; ".join(parts) if parts else ""


def render() -> str:
    results = gather_remotes()
    lay = build_layout(with_device=bool(results))
    record = limits()
    projects = Path(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude").expanduser() / "projects"
    stats = scan(projects)
    name_chars = lay.tokens[0] - 5      # Zellinhalt minus die drei Punkte

    here = device_name()
    for session in stats["sessions"]:
        session["device"] = here
    for result in results:
        if result.get("payload"):
            merge_remote(stats, result["payload"])
    stats["sessions"].sort(key=lambda session: session["window"], reverse=True)

    def token_row(values: list) -> str:
        """values in Spaltenreihenfolge, jeweils (Text, rechtsbündig)."""
        return row([cell(text, width, right)
                    for (text, right), width in zip(values, lay.tokens)])

    def device_part(text):
        return [(text, False)] if lay.with_device else []

    def project_part(text):
        return [(text, False)] if lay.with_project else []

    tier = record.get("tierLabel")
    # Eigene Scan-Zeit, nicht record.updatedAt: die Token-Zahlen unten stammen
    # aus diesem Scan. Der Collector cacht seinen Transcript-Scan 900 s, seine
    # Limits höchstens 15 s — die sind also nie nennenswert älter.
    stamp = dt.datetime.now().astimezone()

    out = [separator(None, (lay.inner,), lay.inner)]

    left = f"Claude Code — {tier}" if tier else "Claude Code"
    right = f"{stats['prompts_today']} Prompts heute · Stand {stamp:%H:%M:%S %Z}"
    gap = max(1, lay.inner - 2 - len(left) - len(right))
    out.append(full_row(left + " " * gap + right, lay.inner))

    # Limits
    rows = record.get("limits") or []
    out.append(separator((lay.inner,), lay.limits if rows else (lay.inner,), lay.inner))
    if rows:
        for limit in rows:
            pct = float(limit.get("percent") or 0)
            reset = parse_ts(limit.get("resetsAt"))
            out.append(row([
                cell(str(limit.get("label", "")), lay.limits[0]),
                cell(f"{int(pct * 100)}%", lay.limits[1], right=True),
                cell(bar(pct, lay.limits[2] - 2), lay.limits[2]),
                cell(f"Reset {reset:%d.%m. %H:%M}" if reset else "—", lay.limits[3]),
            ]))
    else:
        hint = record.get("authHelpText") or record.get("note") or "Keine Limits verfügbar."
        out.append(full_row(hint, lay.inner))

    # Tokens: Kopfzeile und Gesamtsumme
    out.append(separator(lay.limits if rows else (lay.inner,), lay.tokens, lay.inner))
    out.append(token_row(
        [("Tokens", False)] + device_part("Gerät")
        + [("heute", True), (f"{WINDOW_HOURS} h", True), ("gesamt", True), ("seit", False)]
        + project_part("Projekt")))
    out.append(separator(lay.tokens, lay.tokens, lay.inner))
    out.append(token_row(
        [("Alle Sessions", False)] + device_part("")
        + [(tokens(stats["total_today"]), True), (tokens(stats["total_window"]), True),
           ("", True), ("", False)]
        + project_part("")))

    # Eine Zeile je Session mit Aktivität im Fenster
    if stats["sessions"]:
        out.append(separator(lay.tokens, lay.tokens, lay.inner))
        limit = int(config().get("maxSessions") or SESSION_ROWS)
        shown, rest = stats["sessions"][:limit], stats["sessions"][limit:]
        for session in shown:
            out.append(token_row(
                [(clip(session["name"], name_chars), False)]
                + device_part(session.get("device", ""))
                + [(tokens(session["today"]), True), (tokens(session["window"]), True),
                   (tokens(session["lifetime"]), True),
                   (when(session["start"]) if session["start"] else "—", False)]
                + project_part(session["cwd"])))

        if rest:
            # Die Summen oben decken alle Sessions ab; hier geht es nur darum,
            # die Liste nicht ins Endlose wachsen zu lassen.
            out.append(token_row(
                [(f"… {len(rest)} weitere", False)] + device_part("")
                + [(tokens(sum(s["today"] for s in rest)), True),
                   (tokens(sum(s["window"] for s in rest)), True),
                   ("", True), ("", False)]
                + project_part("")))

    # Nur melden, wenn mit einem Remote etwas nicht stimmt
    notes = [note for note in (remote_note(result) for result in results) if note]
    if notes:
        out.append(separator(lay.tokens, (lay.inner,), lay.inner))
        for note in notes:
            out.append(full_row(note, lay.inner))

    # Drei Verlaufsspalten, je Spalte auf das eigene Maximum skaliert — die
    # Größenordnungen von 3 h, Tag und Woche liegen zu weit auseinander.
    series = stats["graph"]
    peaks = [max((value for _, _, value, _ in column), default=0) for column in series]
    out.append(separator((lay.inner,) if notes else lay.tokens, lay.graph, lay.inner))
    out.append(row([
        cell(f"{WINDOW_HOURS} h · 3 h je Zeile", lay.graph[0]),
        cell(f"{GRAPH_ROWS} Tage", lay.graph[1]),
        cell(f"{GRAPH_ROWS} Wochen", lay.graph[2]),
    ]))
    out.append(separator(lay.graph, lay.graph, lay.inner))
    for index in range(GRAPH_ROWS):
        cells = []
        for width, label_chars, column, peak in zip(lay.graph, GRAPH_LABELS, series, peaks):
            _, label, value, color = column[index]
            bar_chars = width - 2 - label_chars - 2 - VALUE_CHARS
            cells.append(cell(
                f"{tint(f'{label:<{label_chars}}', color)} {dots(value, peak, bar_chars)} "
                f"{tokens(value):>{VALUE_CHARS}}",
                width,
            ))
        out.append(row(cells))

    out.append(separator(lay.graph, None, lay.inner))
    return "\n".join(out)


def main() -> int:
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv and argv[0] == "--export":
        projects = Path(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude").expanduser() / "projects"
        json.dump(export_payload(scan(projects)), sys.stdout)
        sys.stdout.write("\n")
        return 0
    if argv and argv[0] in ("-w", "--watch"):
        # Der Collector drosselt den Limits-Endpoint auf 15 s; schneller zu
        # pollen bringt keine frischeren Zahlen, nur Last.
        interval = max(15.0, float(argv[1]) if len(argv) > 1 else 60.0)
        while True:
            text = render()
            os.system("clear")
            print(text, flush=True)
            time.sleep(interval)
    print(render())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
